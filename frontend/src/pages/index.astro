---
import Layout from "../layouts/Layout.astro";
---

<Layout title="ElectroShop - Your online store">
    <!-- Modern Hero Section -->
    <section
        class="relative min-h-screen flex items-center justify-center overflow-hidden bg-stone-50 pt-16"
    >
        <!-- Animated Background Elements -->
        <div class="absolute inset-0 opacity-20">
            <div
                class="floating-shape absolute top-20 left-10 w-72 h-72 bg-gradient-to-r from-blue-100 to-blue-200 rounded-full blur-3xl"
            >
            </div>
            <div
                class="floating-shape absolute bottom-20 right-10 w-96 h-96 bg-gradient-to-r from-blue-100 to-blue-200 rounded-full blur-3xl"
            >
            </div>
            <div
                class="floating-shape absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-gradient-to-r from-blue-100 to-blue-200 rounded-full blur-3xl"
            >
            </div>
        </div>

        <!-- Grid Pattern Overlay -->
        <div class="absolute inset-0 opacity-5">
            <div
                class="grid-pattern w-full h-full"
                style="background-image: linear-gradient(rgba(0,0,0,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.1) 1px, transparent 1px); background-size: 50px 50px;"
            >
            </div>
        </div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center"
        >
            <!-- Main Content -->
            <div class="hero-content space-y-8">
                <!-- Badge -->
                <div class="hero-badge">
                    <span
                        class="inline-flex items-center px-6 py-2 rounded-full text-sm font-medium bg-gray-900/10 backdrop-blur-sm border border-gray-300/20 text-gray-700"
                    >
                        ⚡ New Electronics Collection 2024
                    </span>
                </div>

                <!-- Main Title with Gradient Text -->
                <div class="hero-title">
                    <h1
                        class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black leading-tight"
                    >
                        <span class="block text-stone-900 mb-2">Welcome to</span
                        >
                        <span
                            class="block bg-gradient-to-r from-blue-800 via-blue-600 to-blue-800 bg-clip-text text-transparent animate-gradient"
                        >
                            ElectroShop
                        </span>
                    </h1>
                </div>

                <!-- Subtitle -->
                <div class="hero-subtitle max-w-2xl mx-auto">
                    <p
                        class="text-xl md:text-2xl text-gray-600 leading-relaxed"
                    >
                        Discover cutting-edge technology and premium electronics
                        with
                        <span class="text-gray-800 font-semibold"
                            >lightning-fast delivery</span
                        >
                        and unbeatable prices
                    </p>
                </div>

                <!-- CTA Buttons -->
                <div
                    class="hero-buttons flex flex-col sm:flex-row gap-4 justify-center items-center pt-8"
                >
                    <a
                        href="/products"
                        class="group relative px-8 py-4 bg-gray-900 text-white font-semibold rounded-2xl transition-all duration-300 hover:shadow-lg hover:shadow-gray-900/25 border border-gray-200/20"
                    >
                        <span class="relative z-10">Explore Products</span>
                        <div
                            class="absolute inset-0 rounded-2xl bg-gray-800 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                        >
                        </div>
                    </a>
                    <a
                        href="/register"
                        class="group px-8 py-4 bg-gray-900/5 backdrop-blur-sm text-gray-800 font-semibold rounded-2xl border border-gray-300/30 transition-all duration-300 hover:bg-gray-900/10"
                    >
                        Get Started
                        <svg
                            class="inline-block ml-2 w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 7l5 5-5 5M6 12h12"></path>
                        </svg>
                    </a>
                </div>

                <!-- Scroll Indicator -->
                <div class="relative z-10 py-8">
                    <div
                        class="scroll-indicator flex flex-col items-center text-gray-500/60 animate-bounce"
                    >
                        <span class="text-sm mb-2">Scroll down</span>
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                        </svg>
                    </div>
                </div>

                <!-- Stats Section -->
                <div
                    class="hero-stats grid grid-cols-1 sm:grid-cols-3 gap-8 pt-8 max-w-2xl mx-auto"
                >
                    <div class="stat-item text-center">
                        <div class="text-3xl font-bold text-gray-800">10K+</div>
                        <div class="text-gray-500 text-sm">Happy Customers</div>
                    </div>
                    <div class="stat-item text-center">
                        <div class="text-3xl font-bold text-gray-800">500+</div>
                        <div class="text-gray-500 text-sm">Products</div>
                    </div>
                    <div class="stat-item text-center">
                        <div class="text-3xl font-bold text-gray-800">24/7</div>
                        <div class="text-gray-500 text-sm">Support</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Custom Styles and Animations -->
    <style>
        @keyframes gradient {
            0%,
            100% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
        }

        .animate-gradient {
            background-size: 200% 200%;
            animation: gradient 3s ease-in-out infinite;
        }

        @keyframes float {
            0%,
            100% {
                transform: translateY(0px) rotate(0deg);
            }
            50% {
                transform: translateY(-20px) rotate(5deg);
            }
        }

        .floating-shape {
            animation: float 6s ease-in-out infinite;
        }

        .floating-shape:nth-child(2) {
            animation-delay: -2s;
        }

        .floating-shape:nth-child(3) {
            animation-delay: -4s;
        }

        /* Glass morphism effect */
        .hero-badge,
        .hero-buttons a {
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
    </style>

    <!-- GSAP Animations Script -->
    <script>
        import { gsap } from "gsap";

        document.addEventListener("DOMContentLoaded", () => {
            // Create timeline for hero animations
            const tl = gsap.timeline();

            // Set initial states
            gsap.set(".hero-badge", { y: 30, opacity: 0 });
            gsap.set(".hero-title h1 span", { y: 50, opacity: 0 });
            gsap.set(".hero-subtitle", { y: 30, opacity: 0 });
            gsap.set(".hero-buttons", { y: 40, opacity: 0 });
            gsap.set(".stat-item", { y: 30, opacity: 0 });
            gsap.set(".scroll-indicator", { y: 20, opacity: 0 });
            gsap.set(".floating-shape", { scale: 0, rotation: 45 });

            // Animate in sequence
            tl.to(".floating-shape", {
                scale: 1,
                rotation: 0,
                duration: 1,
                ease: "back.out(1.7)",
                stagger: 0.1,
            })
                .to(".hero-badge", {
                    y: 0,
                    opacity: 1,
                    duration: 0.4,
                    ease: "power3.out",
                })
                .to(".hero-title h1 span", {
                    y: 0,
                    opacity: 1,
                    duration: 0.6,
                    ease: "power3.out",
                    stagger: 0.1,
                })
                .to(
                    ".hero-subtitle",
                    {
                        y: 0,
                        opacity: 1,
                        duration: 0.4,
                        ease: "power3.out",
                    },
                    "-=0.2",
                )
                .to(
                    ".hero-buttons",
                    {
                        y: 0,
                        opacity: 1,
                        duration: 0.4,
                        ease: "power3.out",
                    },
                    "-=0.2",
                )
                .to(
                    ".stat-item",
                    {
                        y: 0,
                        opacity: 1,
                        duration: 0.4,
                        ease: "power3.out",
                        stagger: 0.05,
                    },
                    "-=0.1",
                )
                .to(
                    ".scroll-indicator",
                    {
                        y: 0,
                        opacity: 1,
                        duration: 0.4,
                        ease: "power3.out",
                    },
                    "-=0.1",
                );

            // Continuous animations
            gsap.to(".floating-shape", {
                rotation: 360,
                duration: 20,
                ease: "none",
                repeat: -1,
            });

            // Parallax effect on scroll
            window.addEventListener("scroll", () => {
                const scrolled = window.pageYOffset;
                const parallax = document.querySelectorAll(".floating-shape");
                const speed = 0.5;

                parallax.forEach((element, index) => {
                    const yPos = -(scrolled * speed * (index + 1) * 0.3);
                    gsap.set(element, { y: yPos });
                });
            });
        });
    </script>

    <!-- Features Section -->
    <section class="py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">
                    Why choose ElectroShop?
                </h2>
                <p class="text-lg text-gray-600">
                    We offer the best online shopping experience
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="text-center p-6">
                    <div
                        class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
                    >
                        <svg
                            class="w-8 h-8 text-blue-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">Fast Delivery</h3>
                    <p class="text-gray-600">
                        Receive your products in record time with our optimized
                        shipping system.
                    </p>
                </div>

                <div class="text-center p-6">
                    <div
                        class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
                    >
                        <svg
                            class="w-8 h-8 text-green-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">
                        Guaranteed Quality
                    </h3>
                    <p class="text-gray-600">
                        All our products go through strict quality controls.
                    </p>
                </div>

                <div class="text-center p-6">
                    <div
                        class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"
                    >
                        <svg
                            class="w-8 h-8 text-purple-600"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold mb-2">Secure Shopping</h3>
                    <p class="text-gray-600">
                        Your data and payments are protected with the best
                        security technology.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-stone-50 py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">
                Ready to start?
            </h2>
            <p class="text-lg text-gray-600 mb-8">
                Join thousands of satisfied customers and discover our products
            </p>
            <a
                href="/products"
                class="bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors"
            >
                Explore Products
            </a>
        </div>
    </section>
</Layout>
