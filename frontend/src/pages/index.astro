---
import Layout from "../layouts/Layout.astro";
import FeatureCards from "../features/home/components/FeatureCards.astro";
import styles from "../styles/home.module.css";
---

<Layout title="E-Commerce - Inicio">
  <section class={styles.hero}>
    <h1 class={styles.heroTitle}>Bienvenido a nuestro E-Commerce</h1>
    <p class={styles.heroSubtitle}>Encuentra los mejores productos al mejor precio con envío gratis y garantía de calidad</p>
  </section>

  <section class={styles.ctaSection}>
    <div class="container mx-auto text-center">
      <FeatureCards />
    </div>
  </section>
</Layout>
