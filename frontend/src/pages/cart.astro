---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Shopping Cart - AstroShop">
    <div class="bg-gray-50 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <h1 class="text-3xl font-extrabold text-gray-900 mb-8">
                Shopping Cart
            </h1>

            <!-- Loading state -->
            <div id="loadingState" class="text-center py-12">
                <div
                    class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"
                >
                </div>
                <p class="mt-2 text-gray-600">Loading cart...</p>
            </div>

            <!-- Error state -->
            <div id="errorState" class="text-center py-12 hidden">
                <div class="text-red-500 mb-4">
                    <svg
                        class="mx-auto h-12 w-12"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">
                    Error loading cart
                </h3>
                <p class="text-gray-600 mb-4">
                    Could not load your cart. Please try again.
                </p>
                <button
                    id="retryBtn"
                    class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 transition-colors"
                >
                    Retry
                </button>
            </div>

            <!-- Empty cart state -->
            <div id="emptyState" class="text-center py-12 hidden">
                <div class="text-gray-400 mb-4">
                    <svg
                        class="mx-auto h-16 w-16"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.5 6M7 13l-1.5-6m0 0h15M17 21a2 2 0 100-4 2 2 0 000 4zM9 21a2 2 0 100-4 2 2 0 000 4z"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-medium text-gray-900 mb-2">
                    Your cart is empty
                </h3>
                <p class="text-gray-600 mb-6">
                    Add some products to start shopping
                </p>
                <a
                    href="/products"
                    class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition-colors"
                >
                    Explore Products
                </a>
            </div>

            <!-- Cart content -->
            <div id="cartContent" class="hidden">
                <div
                    class="lg:grid lg:grid-cols-12 lg:gap-x-12 lg:items-start xl:gap-x-16"
                >
                    <!-- Cart items -->
                    <section class="lg:col-span-7">
                        <div class="bg-white shadow rounded-lg">
                            <div class="px-4 py-6 sm:px-6">
                                <h2
                                    class="text-lg font-medium text-gray-900 mb-4"
                                >
                                    Products in your cart
                                </h2>
                                <div id="cartItems" class="space-y-6">
                                    <!-- Cart items will be loaded here -->
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Order summary -->
                    <section
                        class="mt-16 bg-white rounded-lg shadow px-4 py-6 sm:p-6 lg:p-8 lg:mt-0 lg:col-span-5"
                    >
                        <h2 class="text-lg font-medium text-gray-900 mb-4">
                            Order summary
                        </h2>

                        <div class="space-y-4">
                            <div class="flex items-center justify-between">
                                <dt class="text-sm text-gray-600">Subtotal</dt>
                                <dd
                                    class="text-sm font-medium text-gray-900"
                                    id="subtotal"
                                >
                                    $0.00
                                </dd>
                            </div>

                            <div class="flex items-center justify-between">
                                <dt class="text-sm text-gray-600">Shipping</dt>
                                <dd class="text-sm font-medium text-gray-900">
                                    $5.00
                                </dd>
                            </div>

                            <div class="flex items-center justify-between">
                                <dt class="text-sm text-gray-600">Taxes</dt>
                                <dd
                                    class="text-sm font-medium text-gray-900"
                                    id="taxes"
                                >
                                    $0.00
                                </dd>
                            </div>

                            <div
                                class="border-t border-gray-200 pt-4 flex items-center justify-between"
                            >
                                <dt class="text-base font-medium text-gray-900">
                                    Total
                                </dt>
                                <dd
                                    class="text-base font-medium text-gray-900"
                                    id="total"
                                >
                                    $0.00
                                </dd>
                            </div>
                        </div>

                        <div class="mt-6">
                            <button
                                id="checkoutBtn"
                                class="w-full bg-blue-600 border border-transparent rounded-md shadow-sm py-3 px-4 text-base font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
                            >
                                Proceed to Checkout
                            </button>
                        </div>

                        <div class="mt-6 text-center">
                            <a
                                href="/products"
                                class="text-sm text-blue-600 hover:text-blue-500"
                            >
                                Continue shopping
                                <span aria-hidden="true"> →</span>
                            </a>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { apiService } from "../services/api";
    import type { Cart, CartItem } from "../types";

    // DOM Elements
    const loadingState = document.getElementById("loadingState")!;
    const errorState = document.getElementById("errorState")!;
    const emptyState = document.getElementById("emptyState")!;
    const cartContent = document.getElementById("cartContent")!;
    const cartItems = document.getElementById("cartItems")!;
    const retryBtn = document.getElementById("retryBtn")!;
    const checkoutBtn = document.getElementById("checkoutBtn")!;
    const subtotalEl = document.getElementById("subtotal")!;
    const taxesEl = document.getElementById("taxes")!;
    const totalEl = document.getElementById("total")!;

    let currentCart: Cart | null = null;

    // Function to show different states
    function showState(state: "loading" | "error" | "empty" | "cart") {
        const states = [loadingState, errorState, emptyState, cartContent];
        states.forEach((el) => el.classList.add("hidden"));

        switch (state) {
            case "loading":
                loadingState.classList.remove("hidden");
                break;
            case "error":
                errorState.classList.remove("hidden");
                break;
            case "empty":
                emptyState.classList.remove("hidden");
                break;
            case "cart":
                cartContent.classList.remove("hidden");
                break;
        }
    }

    // Function to create the HTML for a cart item
    function createCartItemHTML(item: CartItem): string {
        return `
      <div class="flex items-center space-x-4 py-4 border-b border-gray-200 last:border-b-0" data-item-id="${item.id}">
        <div class="flex-shrink-0">
          <img
            class="h-20 w-20 rounded-md object-cover"
            src="${item.product.image || "/placeholder-product.jpg"}"
            alt="${item.product.title || "Product image"}"
            onerror="this.src='/placeholder-product.jpg'"
          />
        </div>

        <div class="flex-1 min-w-0">
          <h3 class="text-sm font-medium text-gray-900">
            ${item.product.title}
          </h3>
          <p class="text-sm text-gray-500 mt-1">
            ${item.product.description}
          </p>
          <p class="text-sm font-medium text-gray-900 mt-1">
            $${item.product.price.toFixed(2)}
          </p>
        </div>

        <div class="flex items-center space-x-2">
          <button
            onclick="updateQuantity('${item.id}', ${item.quantity - 1})"
            class="p-1 rounded-md hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed"
            ${item.quantity <= 1 ? "disabled" : ""}
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
            </svg>
          </button>

          <span class="text-sm font-medium text-gray-900 min-w-[2rem] text-center">
            ${item.quantity}
          </span>

          <button
            onclick="updateQuantity('${item.id}', ${item.quantity + 1})"
            class="p-1 rounded-md hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed"
            ${item.quantity >= item.product.stock ? "disabled" : ""}
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
          </button>
        </div>

        <div class="text-right">
          <p class="text-sm font-medium text-gray-900">
            $${(item.product.price * item.quantity).toFixed(2)}
          </p>
          <button
            onclick="removeItem('${item.id}')"
            class="text-sm text-red-600 hover:text-red-500 mt-1"
          >
            Remove
          </button>
        </div>
      </div>
    `;
    }

    // Function to update the order summary
    function updateOrderSummary(cart: Cart) {
        const subtotal = cart.total;
        const shipping = 5.0;
        const taxes = subtotal * 0.1; // 10% tax
        const total = subtotal + shipping + taxes;

        subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
        taxesEl.textContent = `$${taxes.toFixed(2)}`;
        totalEl.textContent = `$${total.toFixed(2)}`;
    }

    // Function to render the cart
    function renderCart(cart: Cart) {
        if (!cart.items || cart.items.length === 0) {
            showState("empty");
            return;
        }

        const html = cart.items.map(createCartItemHTML).join("");
        cartItems.innerHTML = html;
        updateOrderSummary(cart);
        showState("cart");
    }

    // Function to load the cart
    async function loadCart() {
        if (!apiService.isAuthenticated()) {
            showState("empty");
            return;
        }

        showState("loading");

        try {
            const response = await apiService.getCart();

            if (response.success && response.data) {
                currentCart = response.data;
                renderCart(currentCart);
            } else {
                showState("error");
            }
        } catch (error) {
            console.error("Error loading cart:", error);
            showState("error");
        }
    }

    // Function to update quantity (global for onclick)
    (window as any).updateQuantity = async function (
        itemId: string,
        newQuantity: number,
    ) {
        if (newQuantity < 1) return;

        // Temporarily disable buttons
        const itemElement = document.querySelector(
            `[data-item-id="${itemId}"]`,
        );
        const buttons = itemElement?.querySelectorAll("button");
        buttons?.forEach((btn) => {
            btn.disabled = true;
            btn.classList.add("opacity-50", "cursor-not-allowed");
        });

        try {
            const response = await apiService.updateCartItem(
                itemId,
                newQuantity,
            );

            if (response.success) {
                showNotification("Quantity updated successfully", "success");
                await loadCart(); // Reload the cart
                // Update cart badge counter
                if (typeof (window as any).updateCartBadge === "function") {
                    (window as any).updateCartBadge();
                }
            } else {
                showNotification(
                    response.error || "Error updating quantity",
                    "error",
                );
            }
        } catch (error) {
            showNotification("Connection error. Please try again.", "error");
        } finally {
            // Re-enable buttons
            buttons?.forEach((btn) => {
                btn.disabled = false;
                btn.classList.remove("opacity-50", "cursor-not-allowed");
            });
        }
    };

    // Function to remove item (global for onclick)
    (window as any).removeItem = async function (itemId: string) {
        if (
            !confirm(
                "Are you sure you want to remove this product from the cart?",
            )
        ) {
            return;
        }

        // Temporarily disable button
        const itemElement = document.querySelector(
            `[data-item-id="${itemId}"]`,
        );
        const removeButton = itemElement?.querySelector(
            'button[onclick*="removeItem"]',
        ) as HTMLButtonElement;
        if (removeButton) {
            removeButton.disabled = true;
            removeButton.textContent = "Removing...";
            removeButton.classList.add("opacity-50", "cursor-not-allowed");
        }

        try {
            const response = await apiService.removeFromCart(itemId);

            if (response.success) {
                showNotification("Product removed from cart", "success");
                await loadCart(); // Reload the cart
                // Update cart badge counter
                if (typeof (window as any).updateCartBadge === "function") {
                    (window as any).updateCartBadge();
                }
            } else {
                showNotification(
                    response.error || "Error removing product",
                    "error",
                );
            }
        } catch (error) {
            showNotification("Connection error. Please try again.", "error");
        } finally {
            if (removeButton) {
                removeButton.disabled = false;
                removeButton.textContent = "Remove";
                removeButton.classList.remove(
                    "opacity-50",
                    "cursor-not-allowed",
                );
            }
        }
    };

    // Function to show notifications
    function showNotification(
        message: string,
        type: "success" | "error" | "warning",
    ) {
        // Create notification element
        const notification = document.createElement("div");
        notification.className = `fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg max-w-sm transform transition-all duration-300 translate-x-full`;

        // Styles according to type
        switch (type) {
            case "success":
                notification.classList.add("bg-green-500", "text-white");
                break;
            case "error":
                notification.classList.add("bg-red-500", "text-white");
                break;
            case "warning":
                notification.classList.add("bg-yellow-500", "text-white");
                break;
        }

        notification.innerHTML = `
      <div class="flex items-center">
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.parentElement.remove()" class="ml-2 text-white hover:text-gray-200">
          ×
        </button>
      </div>
    `;

        document.body.appendChild(notification);

        // Animate entrance
        setTimeout(() => {
            notification.classList.remove("translate-x-full");
        }, 100);

        // Auto-remove after 5 seconds
        setTimeout(() => {
            notification.classList.add("translate-x-full");
            setTimeout(() => {
                notification.remove();
            }, 300);
        }, 5000);
    }

    // Event listeners
    retryBtn.addEventListener("click", loadCart);

    checkoutBtn.addEventListener("click", () => {
        if (!currentCart || currentCart.items.length === 0) {
            showNotification("Your cart is empty", "warning");
            return;
        }

        // Redirect to checkout page
        window.location.href = "/checkout";
    });

    // Check authentication and load cart
    if (!apiService.isAuthenticated()) {
        // Show message for unauthenticated users
        emptyState.innerHTML = `
      <div class="text-center py-12">
        <div class="text-gray-400 mb-4">
          <svg class="mx-auto h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h3 class="text-xl font-medium text-gray-900 mb-2">Log in to see your cart</h3>
        <p class="text-gray-600 mb-6">You need an account to save products in your cart</p>
        <div class="space-x-4">
          <a
            href="/login"
            class="bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700 transition-colors"
          >
            Log In
          </a>
          <a
            href="/register"
            class="border border-blue-600 text-blue-600 px-6 py-3 rounded-md hover:bg-blue-50 transition-colors"
          >
            Register
          </a>
        </div>
      </div>
    `;
        showState("empty");
    } else {
        loadCart();
    }
</script>
