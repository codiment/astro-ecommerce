---
import Layout from "../layouts/Layout.astro";
---

<Layout title="My Orders">
    <div class="min-h-screen bg-gray-50 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white shadow rounded-lg">
                <div class="px-4 py-5 sm:p-6">
                    <h1 class="text-2xl font-bold text-gray-900 mb-6">
                        My Orders
                    </h1>

                    <!-- Loading State -->
                    <div id="loadingState" class="text-center py-8">
                        <div
                            class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto"
                        >
                        </div>
                        <p class="mt-4 text-gray-600">Loading orders...</p>
                    </div>

                    <!-- Error State -->
                    <div id="errorState" class="hidden text-center py-8">
                        <div class="text-red-500 mb-4">
                            <svg
                                class="mx-auto h-12 w-12"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.962-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">
                            Error loading orders
                        </h3>
                        <p class="text-gray-600 mb-4">
                            Could not load your orders. Please try again.
                        </p>
                        <button
                            id="retryBtn"
                            class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors"
                        >
                            Retry
                        </button>
                    </div>

                    <!-- Empty State -->
                    <div id="emptyState" class="hidden text-center py-8">
                        <div class="text-gray-400 mb-4">
                            <svg
                                class="mx-auto h-12 w-12"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">
                            You have no orders
                        </h3>
                        <p class="text-gray-600 mb-4">
                            You haven't made any purchases yet.
                        </p>
                        <a
                            href="/products"
                            class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors inline-block"
                        >
                            Explore Products
                        </a>
                    </div>

                    <!-- Orders List -->
                    <div id="ordersContainer" class="hidden space-y-6">
                        <!-- Orders will be populated here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Notification -->
    <div id="notification" class="hidden fixed top-4 right-4 z-50">
        <div
            class="bg-white border border-gray-200 rounded-lg shadow-lg p-4 max-w-sm"
        >
            <div class="flex items-center">
                <div id="notificationIcon" class="flex-shrink-0"></div>
                <div class="ml-3">
                    <p
                        id="notificationMessage"
                        class="text-sm font-medium text-gray-900"
                    >
                    </p>
                </div>
                <div class="ml-auto pl-3">
                    <button
                        id="closeNotification"
                        class="text-gray-400 hover:text-gray-600"
                    >
                        <span class="sr-only">Close</span>
                        <svg
                            class="h-5 w-5"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    import { apiService } from "../services/api";

    // Elements
    const loadingState = document.getElementById("loadingState")!;
    const errorState = document.getElementById("errorState")!;
    const emptyState = document.getElementById("emptyState")!;
    const ordersContainer = document.getElementById("ordersContainer")!;
    const retryBtn = document.getElementById("retryBtn")!;
    const notification = document.getElementById("notification")!;
    const notificationMessage = document.getElementById("notificationMessage")!;
    const notificationIcon = document.getElementById("notificationIcon")!;
    const closeNotification = document.getElementById("closeNotification")!;

    let currentOrders: any[] = [];

    // Notification functions
    function showNotification(
        message: string,
        type: "success" | "error" | "warning" = "success",
    ) {
        notificationMessage.textContent = message;

        // Set icon based on type
        const iconColors = {
            success: "text-green-500",
            error: "text-red-500",
            warning: "text-yellow-500",
        };

        notificationIcon.innerHTML = `
      <svg class="h-5 w-5 ${iconColors[type]}" fill="currentColor" viewBox="0 0 20 20">
        ${
            type === "success"
                ? '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />'
                : type === "error"
                  ? '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />'
                  : '<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />'
        }
      </svg>
    `;

        notification.classList.remove("hidden");

        setTimeout(() => {
            notification.classList.add("hidden");
        }, 5000);
    }

    closeNotification.addEventListener("click", () => {
        notification.classList.add("hidden");
    });

    // Format date
    function formatDate(dateString: string): string {
        const date = new Date(dateString);
        return date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
        });
    }

    // Format currency
    function formatCurrency(amount: number): string {
        return new Intl.NumberFormat("en-US", {
            style: "currency",
            currency: "USD",
        }).format(amount);
    }

    // Get status badge
    function getStatusBadge(status: string): string {
        const statusConfig = {
            PENDING: {
                color: "bg-yellow-100 text-yellow-800",
                text: "Pending",
            },
            PAID: { color: "bg-green-100 text-green-800", text: "Paid" },
            CANCELLED: { color: "bg-red-100 text-red-800", text: "Cancelled" },
        };

        const config =
            statusConfig[status as keyof typeof statusConfig] ||
            statusConfig["PENDING"];
        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${config.color}">${config.text}</span>`;
    }

    // Render orders
    function renderOrders(orders: any[]) {
        if (orders.length === 0) {
            showEmptyState();
            return;
        }

        ordersContainer.innerHTML = orders
            .map(
                (order) => `
      <div class="border border-gray-200 rounded-lg p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="text-lg font-medium text-gray-900">Order #${order.id}</h3>
            <p class="text-sm text-gray-500">${formatDate(order.createdAt)}</p>
          </div>
          <div class="flex items-center space-x-4">
            ${getStatusBadge(order.status)}
            <span class="text-lg font-bold text-gray-900">${formatCurrency(order.total)}</span>
          </div>
        </div>

        <div class="space-y-3">
          ${order.items
              .map(
                  (item: any) => `
            <div class="flex items-center space-x-4">
              <img
                src="${item.product.image || "/placeholder-product.jpg"}"
                alt="${item.product.title}"
                class="w-12 h-12 object-cover rounded-md"
              />
              <div class="flex-1">
                <h4 class="text-sm font-medium text-gray-900">${item.product.title}</h4>
                <p class="text-sm text-gray-500">Quantity: ${item.quantity}</p>
              </div>
              <span class="text-sm font-medium text-gray-900">${formatCurrency(item.price * item.quantity)}</span>
            </div>
          `,
              )
              .join("")}
        </div>
      </div>
    `,
            )
            .join("");

        showOrdersState();
    }

    // State management
    function showLoadingState() {
        loadingState.classList.remove("hidden");
        errorState.classList.add("hidden");
        emptyState.classList.add("hidden");
        ordersContainer.classList.add("hidden");
    }

    function showErrorState() {
        loadingState.classList.add("hidden");
        errorState.classList.remove("hidden");
        emptyState.classList.add("hidden");
        ordersContainer.classList.add("hidden");
    }

    function showEmptyState() {
        loadingState.classList.add("hidden");
        errorState.classList.add("hidden");
        emptyState.classList.remove("hidden");
        ordersContainer.classList.add("hidden");
    }

    function showOrdersState() {
        loadingState.classList.add("hidden");
        errorState.classList.add("hidden");
        emptyState.classList.add("hidden");
        ordersContainer.classList.remove("hidden");
    }

    // Load orders
    async function loadOrders() {
        try {
            showLoadingState();

            const response = await apiService.getUserOrders();

            if (response.success && response.data) {
                currentOrders = response.data;
                renderOrders(currentOrders);
            } else {
                throw new Error(response.error || "Error loading orders");
            }
        } catch (error) {
            console.error("Error loading orders:", error);
            showErrorState();
            showNotification("Error loading orders", "error");
        }
    }

    // Event listeners
    retryBtn.addEventListener("click", loadOrders);

    // Initialize
    document.addEventListener("DOMContentLoaded", () => {
        // Check authentication
        if (!apiService.isAuthenticated()) {
            window.location.href = "/login";
            return;
        }

        loadOrders();
    });
</script>

<style>
    .animate-spin {
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
</style>
