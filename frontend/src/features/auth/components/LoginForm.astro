---
import { Mail, Lock, Github } from '@lucide/astro';
import styles from '../../../styles/auth.module.css';
---

<div class={styles.container}>
  <div class={styles.card}>
    <div class={styles.header}>
      <h1 class={styles.title}>Iniciar Sesión</h1>
      <p class={styles.subtitle}>Bienvenido de vuelta a tu cuenta</p>
    </div>

    <form class={styles.form} id="loginForm">
      <div class={styles.inputGroup}>
        <label for="email" class={styles.label}>
          <Mail size={16} style="display: inline; margin-right: 0.5rem;" />
          Correo Electrónico
        </label>
        <input
          type="email"
          id="email"
          name="email"
          class={styles.input}
          placeholder="tu@email.com"
          required
        />
      </div>

      <div class={styles.inputGroup}>
        <label for="password" class={styles.label}>
          <Lock size={16} style="display: inline; margin-right: 0.5rem;" />
          Contraseña
        </label>
        <input
          type="password"
          id="password"
          name="password"
          class={styles.input}
          placeholder="••••••••"
          required
        />
      </div>

      <button type="submit" class={styles.submitBtn}>
        Iniciar Sesión
      </button>
    </form>

    <div class={styles.divider}>
      o continúa con
    </div>

    <a href="#" class={styles.socialBtn}>
      <Github size={16} />
      Continuar con GitHub
    </a>

    <div class={styles.footer}>
      ¿No tienes una cuenta?
      <a href="/register" class={styles.link}>Regístrate aquí</a>
    </div>
  </div>
</div>

<script>
  document.getElementById('loginForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);
    const email = formData.get('email');
    const password = formData.get('password');
    
    console.log('Login attempt:', { email, password });
    // Aquí conectarías con tu backend
    alert('Funcionalidad de login pendiente de implementar');
  });
</script>